# Copy to .env and fill in.

# Domain (or subdomain) pointing at your server's static IP. Caddy gets the HTTPS certificate for it.
DOMAIN=trade.example.com

# Optional. Encrypts stored Kotak credentials and signs logins. If left empty a random key is
# generated inside the data volume on first start. If you set it, keep it safe: changing or
# losing it means every account must be re-added.
TRADELAB_SECRET_KEY=

# MongoDB address. docker-compose sets it to its own "mongo" service; set it only to use another
# MongoDB (e.g. MongoDB Atlas). Use a replica set so every save is all-or-nothing.
# TRADELAB_MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
# TRADELAB_MONGO_DB=tradelab

# Allow "Paper (practice)" accounts for dry runs.
TRADELAB_ENABLE_PAPER_TRADING=true

# How long a login stays valid on a device, in hours.
TRADELAB_TOKEN_TTL_HOURS=168
